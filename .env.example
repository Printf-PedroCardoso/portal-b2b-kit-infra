# ==============================================================================
# Configurações de Ambiente da PoC Local (SW-03, RES-13)
# ATENÇÃO: Contém apenas valores fictícios/placeholders para execução local.
# Copie para .env antes de executar: cp .env.example .env
# ==============================================================================

PROJECT_NAME=portal-b2b
ENVIRONMENT=local

# Banco de Dados PostgreSQL 16
POSTGRES_DB=portal_b2b
POSTGRES_MASTER_USER=portal_admin
POSTGRES_MASTER_PASSWORD=ExemploSenhaMasterDev123!#
POSTGRES_REPLICA_USER=replicator
POSTGRES_REPLICA_PASSWORD=ExemploSenhaReplicaDev123!#

# Pool de Conexões do PostgreSQL (RNF-10: máx 5 por réplica de serviço)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Mensageria Redpanda (API Kafka)
KAFKA_BOOTSTRAP_SERVERS=rp-0:19092,rp-1:19092,rp-2:19092
SCHEMA_REGISTRY_URL=http://rp-0:18081

# Autenticação e Segurança (RNF-17)
JWT_SECRET_KEY=exemplo-chave-secreta-jwt-local-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# Ferramentas Administrativas (Credenciais Locais)
PGADMIN_DEFAULT_EMAIL=admin@portalb2b.local
PGADMIN_DEFAULT_PASSWORD=AdminPgLocal123!#
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminGrafanaLocal123!#
