# ==============================================================================
# Exemplo de Backend Remoto para Ambiente de Produção (PROD)
# ==============================================================================

terraform {
  backend "s3" {
    bucket         = "portal-b2b-terraform-state-prod"
    key            = "prod/terraform.tfstate"
    region         = "us-east-2"
    dynamodb_table = "portal-b2b-terraform-locks-prod"
    encrypt        = true
  }
}
